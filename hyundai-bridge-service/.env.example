# Kopieren nach .env und mit echten Werten fuellen:
#   cp .env.example .env
#   chmod 600 .env
#
# Diese Datei (.env) NICHT versionieren/teilen - enthaelt echte Zugangsdaten.

HYUNDAI_USERNAME=deine-email@example.com
HYUNDAI_PASSWORD=dein-bluelink-passwort
HYUNDAI_PIN=1234
HYUNDAI_LANGUAGE=de

# Wie oft der Server-Cache abgefragt wird (Minuten). Das WECKT das Fahrzeug
# NICHT, es liest nur den zuletzt von Hyundai gemeldeten Stand.
HYUNDAI_CACHE_POLL_MINUTES=15
